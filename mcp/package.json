{
  "name": "imago-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Imago by Instrumenta — create thumbnails and title cards locally",
  "main": "./dist/mcp/src/index.js",
  "exports": "./dist/mcp/src/index.js",
  "bin": {
    "imago-mcp": "./dist/mcp/src/index.js"
  },
  "files": [
    "assets/",
    "dist/",
    "fonts/"
  ],
  "scripts": {
    "start": "node dist/mcp/src/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.3",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
