{
  "schemaVersion": 1,
  "id": "imago",
  "displayName": "Imago",
  "kind": "web",
  "adapter": "web-service",
  "versionSource": { "type": "package-json", "path": "package.json" },
  "build": { "output": "web/dist", "command": "npm run build" },
  "launch": {
    "type": "service",
    "port": 49321,
    "fallbackPort": 45021,
    "health": "/api/health",
    "command": ["npm", "start"],
    "cwd": ".",
    "env": {
      "IMAGO_WEB_ROOT": "web/dist"
    }
  },
  "assets": {
    "mark": "web/public/brand/imago.svg"
  }
}
